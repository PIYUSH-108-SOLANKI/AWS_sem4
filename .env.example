# Environment Variables Example File
# Copy this file to .env and adjust values for local development or production.

# Local Database
LOCAL_DB=mysql://root:password@localhost:3306/irrigation_db

# AWS Deployment Readiness
AWS_RDS=your_aws_rds_endpoint
AWS_REGION=us-east-1
S3_BUCKET=irrigaflow-uploads-bucket

# Server Config
PORT=3000
SESSION_SECRET=your_super_secret_session_key
